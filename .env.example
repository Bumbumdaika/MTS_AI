# Copy to .env. Demo runs with Python standard library only.
BOT_MODE=demo
SEARCH_BACKEND=basic
PORT=8000
# For real LLM: BOT_MODE=llm. URL must include /v1 if provider requires it.
LLM_BASE_URL=https://YOUR-PROVIDER/v1
LLM_API_KEY=YOUR-KEY
LLM_MODEL=YOUR-MODEL
LLM_TIMEOUT=30
# Optional: SEARCH_BACKEND=bge; pip install -r requirements.txt first.
